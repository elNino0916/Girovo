{
	"name": "sooskasse-fints",
	"version": "4.1.2",
	"private": true,
	"description": "Sooskasse-FinTS — self-hosted banking app for German banks via FinTS 3.0 (PIN/TAN, decoupled TAN, SEPA & Echtzeitueberweisung)",
	"type": "module",
	"main": "electron/main.cjs",
	"scripts": {
		"dev": "next dev -p 3000",
		"build": "next build",
		"start": "next start -p 3000",
		"typecheck": "tsc --noEmit",
		"update-banks": "node scripts/update-banks.mjs",
		"electron:dev": "cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .",
		"electron:build": "node scripts/build-electron.mjs",
		"electron:start": "electron .",
		"electron:dist": "npm run electron:build && electron-builder --win",
		"postinstall": "patch-package",
		"test": "node --test \"lib/**/*.test.ts\" \"electron/**/*.test.cjs\""
	},
	"keywords": [
		"fints",
		"hbci",
		"banking",
		"sparkasse",
		"vr-bank"
	],
	"author": "elNino0916",
	"license": "MIT",
	"dependencies": {
		"jsqr": "1.4.0",
		"lib-fints": "^1.4.8",
		"next": "^16.2.12",
		"qrcode-generator": "2.0.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"cross-env": "^10.1.0",
		"electron": "^43.2.0",
		"electron-builder": "^26.15.3",
		"fints-institute-db": "^0.16.0",
		"patch-package": "^8.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}

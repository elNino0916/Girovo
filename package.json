{
	"name": "girovo",
	"version": "6.0.0-preview.1",
	"private": true,
	"description": "Girovo — self-hosted banking app for German banks via FinTS 3.0 (PIN/TAN, decoupled TAN, SEPA & Echtzeitueberweisung)",
	"homepage": "https://github.com/elNino0916/Girovo",
	"type": "module",
	"main": "electron/main.cjs",
	"desktopName": "girovo.desktop",
	"scripts": {
		"dev": "next dev -p 3000",
		"build": "next build",
		"start": "next start -p 3000",
		"typecheck": "tsc --noEmit",
		"update-banks": "node scripts/update-banks.mjs",
		"electron:dev": "node scripts/build-windows-hello.mjs && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .",
		"electron:build": "node scripts/build-electron.mjs",
		"electron:start": "electron .",
		"electron:dist": "npm run electron:build -- --platform win32 && electron-builder --win --publish never",
		"electron:dist:linux": "npm run electron:build -- --platform linux && electron-builder --linux --publish never",
		"android": "node scripts/build-android.mjs --install",
		"android:build": "node scripts/build-android.mjs",
		"android:release": "node scripts/build-android.mjs --release && node scripts/build-android.mjs --release --flavor fdroid && node scripts/build-android.mjs --release --flavor play",
		"android:fdroid-repo": "node scripts/fdroid-repo.mjs",
		"android:preview": "cross-env GIROVO_TARGET=android next dev -p 3100",
		"owner-key": "node scripts/owner-key.mjs",
		"postinstall": "patch-package && node scripts/ocr-assets.mjs",
		"test": "node --test \"lib/**/*.test.ts\" \"mobile/**/*.test.ts\" \"electron/**/*.test.cjs\""
	},
	"keywords": [
		"fints",
		"hbci",
		"banking",
		"sparkasse",
		"vr-bank"
	],
	"author": "elNino0916",
	"license": "MIT",
	"dependencies": {
		"@capacitor/android": "^9.0.0-beta.0",
		"@capacitor/app": "^9.0.0-alpha.2",
		"@capacitor/core": "^9.0.0-beta.0",
		"@capacitor/filesystem": "^8.2.0-next.7",
		"@capacitor/haptics": "^9.0.0-next.1",
		"@capacitor/preferences": "^9.0.0-alpha.2",
		"@capacitor/share": "^9.0.0-alpha.2",
		"@capacitor/splash-screen": "^9.0.0-alpha.2",
		"@huggingface/tokenizers": "^0.2.0",
		"@lit/react": "^1.0.8",
		"@m3e/react": "^2.11.3",
		"@m3e/web": "^2.11.3",
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"@tesseract.js-data/deu": "^1.0.0",
		"@tesseract.js-data/eng": "^1.0.0",
		"buffer": "^6.0.3",
		"jsqr": "^1.4.0",
		"lib-fints": "^1.5.3",
		"lit": "^3.3.3",
		"next": "^16.4.5",
		"onnxruntime-node": "^1.31.1",
		"path-browserify": "^1.0.1",
		"pdfjs-dist": "^6.5.438",
		"qrcode-generator": "^2.0.4",
		"react": "^19.3.0-canary-d5736f09-20260507",
		"react-dom": "^19.3.0-canary-d5736f09-20260507",
		"tesseract.js": "^7.0.0",
		"tslib": "^2.9.1"
	},
	"devDependencies": {
		"@capacitor/cli": "^9.0.0-beta.0",
		"@tailwindcss/postcss": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/path-browserify": "^1.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"cross-env": "^10.1.0",
		"electron": "^45.2.3",
		"electron-builder": "^27.0.0-alpha.14",
		"esbuild": "^0.28.2",
		"fints-institute-db": "^0.16.0",
		"patch-package": "^8.0.1",
		"tailwindcss": "^4.3.4",
		"typescript": "^7.1.0-dev.20261105.1"
	},
	"overrides": {
		"xcode": {
			"uuid": "^11.1.1"
		}
	}
}

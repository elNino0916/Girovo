<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact read-only integrity queries; no QUERY_ALL_PACKAGES permission. -->
    <queries>
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="me.bmax.apatch" />
        <package android:name="eu.chainfire.supersu" />
    </queries>

    <!-- No backups (allowBackup, data_extraction_rules): see
         res/xml/data_extraction_rules.xml. No cleartext — and this says so
         over Capacitor's plugin manifest too, which asks for it whenever a
         debug build loads the development server; the network security
         config of a debug build (src/debug) lets just that host through. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme"
        tools:replace="android:usesCleartextTraffic"
        tools:targetApi="34">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- An invoice shared with Girovo, as an image or a PDF: its
                 GiroCode opens a transfer (LaunchPlugin). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Long-pressing the icon: Überweisen, GiroCode scannen, Geld anfordern. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- Google's code scanner hands off to Play services through this
             activity of its own, locked to portrait in its manifest. Android 16
             ignores such locks on large screens, and Play asks apps to drop
             them: Girovo's layout follows any size and orientation. -->
        <activity
            android:name="com.google.mlkit.vision.codescanner.internal.GmsBarcodeScanningDelegateActivity"
            tools:remove="android:screenOrientation" />

        <!-- Play services fetches the code scanner's module with the app,
             not at the first scan. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Keeps the network while the user approves in the bank's app
             (ApprovalService): a short service, at most about three minutes. -->
        <service
            android:name=".ApprovalService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing in the clear, and only the system's certificate authorities: the
     app talks to banks. (The page itself is served from inside the app, which
     needs no network.) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
